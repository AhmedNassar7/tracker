{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobEntry",
  "type": "object",
  "required": [
    "id",
    "company",
    "title",
    "level",
    "country",
    "location",
    "remote_type",
    "url",
    "source",
    "source_url",
    "posted_at",
    "age",
    "collected_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "16-char hex ID (stable hash of company+title+url)"
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "description": "Company name"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Job title"
    },
    "level": {
      "type": "string",
      "enum": ["internship", "new_grad", "junior", "entry_level", "mid_level", "unknown"],
      "description": "Career level detected from title"
    },
    "category": {
      "type": "string",
      "description": "Allowlist category the company matched in config/companies_allowlist.yml (e.g. 'faang', 'big_tech', 'cloud_infra'), or '' if the row was only included via a relaxed-mode fallback without a strict allowlist hit"
    },
    "region": {
      "type": "string",
      "enum": ["us", "canada", "emea", "remote", "unknown"],
      "description": "Coarse region detected from location, same taxonomy as the public layer's region field"
    },
    "role_type": {
      "type": "string",
      "enum": ["full_stack", "backend", "frontend", "mobile", "platform", "infrastructure", "security", "machine_learning", "software_engineer", "other_swe"],
      "description": "Engineering discipline detected from title, same taxonomy as the public layer's role_type"
    },
    "country": {
      "type": "string",
      "description": "Detected country name, or 'Remote'/'Unknown' when not recognized"
    },
    "location": {
      "type": "string",
      "description": "Full location string from source"
    },
    "remote_type": {
      "type": "string",
      "enum": ["remote", "hybrid", "onsite", "unknown"],
      "description": "Work arrangement type"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Direct link to job posting"
    },
    "source": {
      "type": "string",
      "description": "Source ID (remotive, arbeitnow, etc.)"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Source website URL for attribution"
    },
    "posted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date job was posted (YYYY-MM-DD)"
    },
    "age": {
      "type": "string",
      "description": "Human-readable time since posting (e.g. '0d', '5d', 'Recently'), or '' when unknown. Free-form: sourced verbatim from the origin site when available, otherwise computed from posted_at."
    },
    "collected_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC timestamp when collected (ISO 8601)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags (e.g., 'software', 'programming', 'global-tech-roles')"
    },
    "closed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC timestamp this row was archived. Only present in data/jobs-global-archive.json, never in data/jobs-global.json"
    }
  },
  "additionalProperties": false
}
