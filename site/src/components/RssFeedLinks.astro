---
// Plain static links, no JS needed — same jsDelivr CDN mirror the runtime
// data fetch uses (src/lib/dataSource.ts), since data/feeds/*.xml lives in
// the tracker repo, not in this site's own build output.
const FEEDS_BASE = "https://cdn.jsdelivr.net/gh/AhmedNassar7/tracker@main/data/feeds";

const FEEDS = [
	{ id: "all-jobs", label: "All jobs" },
	{ id: "internships", label: "Internships" },
	{ id: "new-grad", label: "New grad" },
	{ id: "hackathons", label: "Hackathons" },
	{ id: "events", label: "Events" },
];
---

<div class="rounded-md border border-slate-200 p-4 text-sm dark:border-slate-800">
	<h2 class="font-semibold text-slate-700 dark:text-slate-300">Job alerts, no account needed</h2>
	<p class="mt-1 text-slate-500 dark:text-slate-400">
		Each link below is an <strong>RSS feed</strong> — a plain web address that updates every hour with
		new matching roles. Paste one into a feed reader (Feedly, Inoreader, Thunderbird, or a Slack /
		Discord RSS bot) and new jobs show up there automatically. No sign-up, no email, nothing to
		install here.
	</p>
	<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
		{
			FEEDS.map((feed) => (
				<li>
					<a
						href={`${FEEDS_BASE}/${feed.id}.xml`}
						class="text-teal-700 underline-offset-2 hover:underline dark:text-teal-400"
					>
						{feed.label}
					</a>
				</li>
			))
		}
	</ul>
	<p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
		These cover the common asks. Feeds for your own saved filter combinations are coming.
	</p>
</div>
