---
import '../styles/global.css';
import { BASE_URL } from '../lib/basePath';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "tracker — job, hackathon & event tracker",
  description = "Software engineering jobs, internships, hackathons, and events, merged hourly from 15+ sources with no signup and no fabricated data.",
} = Astro.props;

const base = BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const NAV_LINKS = [
	{ href: base, label: "Jobs", match: (path: string) => path === base },
	{ href: `${base}resources`, label: "Resources", match: (path: string) => path.startsWith(`${base}resources`) },
	{ href: `${base}applications`, label: "My Applications", match: (path: string) => path.startsWith(`${base}applications`) },
	{ href: `${base}dashboard`, label: "Dashboard", match: (path: string) => path.startsWith(`${base}dashboard`) },
];
const activeHref = NAV_LINKS.find((link) => link.match(Astro.url.pathname))?.href ?? base;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script is:inline>
			// Runs before first paint (blocking, in <head>) so the page never
			// flashes the wrong theme. No stored preference means "follow the
			// OS setting" — an explicit toggle click is the only thing that
			// pins it one way, via the "tracker:theme" localStorage key.
			(function () {
				var stored = localStorage.getItem("tracker:theme");
				var isDark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", isDark);
			})();
		</script>
	</head>
	<body class="min-h-screen bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
		<header
			class="flex items-start justify-between gap-4 border-b border-slate-200 px-4 py-4 dark:border-slate-800 sm:px-8"
		>
			<div>
				<a href={base} class="text-lg font-semibold">tracker</a>
				<p class="text-sm text-slate-500 dark:text-slate-400">
					Software engineering jobs, internships, hackathons, and events — refreshed hourly.
				</p>
				<nav class="mt-2 flex flex-wrap gap-4 text-sm">
					{
						NAV_LINKS.map((link) => {
							const isActive = link.href === activeHref;
							return (
								<a
									href={link.href}
									aria-current={isActive ? "page" : undefined}
									class={
										isActive
											? "font-medium text-teal-700 dark:text-teal-400"
											: "text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
									}
								>
									{link.label}
								</a>
							);
						})
					}
				</nav>
			</div>
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle color theme"
				class="mt-0.5 shrink-0 rounded-md border border-slate-300 p-2 text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900"
			>
				<svg
					id="theme-toggle-icon-sun"
					aria-hidden="true"
					class="hidden h-4 w-4 dark:block"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				>
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
				</svg>
				<svg
					id="theme-toggle-icon-moon"
					aria-hidden="true"
					class="h-4 w-4 dark:hidden"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
			</button>
		</header>
		<main class="px-4 py-6 sm:px-8">
			<slot />
		</main>
		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				btn.addEventListener("click", function () {
					var next = !document.documentElement.classList.contains("dark");
					document.documentElement.classList.toggle("dark", next);
					localStorage.setItem("tracker:theme", next ? "dark" : "light");
				});
			})();
		</script>
	</body>
</html>
