---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { BASE_URL } from '../lib/basePath';
import HeaderStat from '../components/HeaderStat';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "tracker — job, hackathon & event tracker",
  description = "Software engineering jobs, internships, hackathons, and events, merged hourly from 15+ sources with no signup and no fabricated data.",
} = Astro.props;

const base = BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// RSS feeds — data/feeds/*.xml live in the tracker repo, served from the same
// jsDelivr mirror the runtime data fetch uses.
const FEEDS_BASE = "https://cdn.jsdelivr.net/gh/AhmedNassar7/tracker@main/data/feeds";
const FEEDS = [
  { id: "all-jobs", label: "All jobs" },
  { id: "internships", label: "Internships" },
  { id: "new-grad", label: "New grad" },
  { id: "hackathons", label: "Hackathons" },
  { id: "events", label: "Events" },
];

const repoUrl = "https://github.com/AhmedNassar7/tracker";
const sponsorUrl = "https://github.com/sponsors/AhmedNassar7";

const NAV_LINKS = [
	{ href: base, label: "Jobs", match: (path: string) => path === base },
	{ href: `${base}dashboard`, label: "Dashboard", match: (path: string) => path.startsWith(`${base}dashboard`) },
	{
		href: `${base}profile`,
		label: "My Workspace",
		match: (path: string) =>
			path.startsWith(`${base}profile`) ||
			path.startsWith(`${base}applications`) ||
			path.startsWith(`${base}toolkit`),
	},
];
const activeHref = NAV_LINKS.find((link) => link.match(Astro.url.pathname))?.href ?? base;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="manifest" href={`${base}manifest.webmanifest`} />
		<meta name="theme-color" content="#0f766e" />
		{/* robots.txt here would have no effect — crawlers only ever check
		it at the true host root, which this GitHub Pages project sub-path
		doesn't control (see tracker-website-plan.html §7's custom-domain
		research). This <link> is the discovery path that still works from
		a sub-path: search engines and Search Console both honor it. */}
		<link rel="sitemap" href={`${base}sitemap-index.xml`} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* Native cross-document view transitions — instant nav between
		Jobs / Dashboard / Applications with a soft fade, no SPA framework.
		Honors prefers-reduced-motion automatically. */}
		<ClientRouter />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script is:inline>
			// Runs before first paint (blocking, in <head>) so the page never
			// flashes the wrong theme. No stored preference means "follow the
			// OS setting" — an explicit toggle click is the only thing that
			// pins it one way, via the "tracker:theme" localStorage key.
			(function () {
				function applyTheme() {
					var stored = localStorage.getItem("tracker:theme");
					var isDark = stored
						? stored === "dark"
						: window.matchMedia("(prefers-color-scheme: dark)").matches;
					document.documentElement.classList.toggle("dark", isDark);
				}
				applyTheme();
				// ClientRouter swaps <head> on navigation — re-apply before the
				// new document paints so a page change never flashes light-on-dark.
				document.addEventListener("astro:after-swap", applyTheme);
			})();
		</script>
	</head>
	<body class="min-h-screen bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
		<header
			class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-slate-200 px-4 py-3 dark:border-slate-800 sm:px-8"
		>
			{/* Left cluster: brand + primary nav. Explicitly its own flex group
			(not just "whatever's left of a spacer") so it wraps as one unit on
			narrow screens instead of the nav links drifting independently. */}
			<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
				<a href={base} class="flex shrink-0 items-center gap-2 text-lg font-semibold tracking-tight">
					<svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 128 128">
						<rect width="128" height="128" rx="28" class="fill-teal-700 dark:fill-teal-500" />
						<g fill="none" stroke="#fff" stroke-width="9">
							<circle cx="64" cy="64" r="34" />
							<circle cx="64" cy="64" r="15" />
						</g>
						<circle cx="64" cy="64" r="6" fill="#fff" />
						<g stroke="#fff" stroke-width="9" stroke-linecap="round">
							<path d="M64 18v14M64 96v14M18 64h14M96 64h14" />
						</g>
					</svg>
					Tracker
				</a>
				<nav class="flex flex-wrap gap-4 text-sm">
					{
						NAV_LINKS.map((link) => {
							const isActive = link.href === activeHref;
							return (
								<a
									href={link.href}
									aria-current={isActive ? "page" : undefined}
									data-astro-prefetch="viewport"
									data-tour-target={link.label === "My Workspace" ? "workspace-nav" : undefined}
									class={
										isActive
											? "font-medium text-teal-700 dark:text-teal-400"
											: "text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
									}
								>
									{link.label}
								</a>
							);
						})
					}
				</nav>
			</div>

			{/* Right cluster: the live open-opportunity count (every page, not
			just the homepage hero) and the theme toggle. */}
			<div class="flex shrink-0 items-center gap-3">
				<HeaderStat client:load />
				<button
					id="theme-toggle"
					type="button"
					aria-label="Toggle color theme"
					class="shrink-0 rounded-md border border-slate-300 p-2 text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900"
				>
					<svg
						id="theme-toggle-icon-sun"
						aria-hidden="true"
						class="hidden h-4 w-4 dark:block"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
					</svg>
					<svg
						id="theme-toggle-icon-moon"
						aria-hidden="true"
						class="h-4 w-4 dark:hidden"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
				</button>
			</div>
		</header>
		<main class="px-4 py-6 sm:px-8">
			<slot />
		</main>
		<footer class="mt-8 border-t border-slate-200 px-4 py-8 text-sm dark:border-slate-800 sm:px-8">
			<div class="mx-auto max-w-xl space-y-4 text-center">
				<div data-tour-target="rss-feeds" class="flex flex-wrap justify-center gap-x-3 gap-y-1">
					<span class="text-slate-400 dark:text-slate-500">Alerts (RSS):</span>
					{
						FEEDS.map((feed) => (
							<a
								href={`${FEEDS_BASE}/${feed.id}.xml`}
								class="text-teal-700 underline-offset-2 hover:underline dark:text-teal-400"
							>
								{feed.label}
							</a>
						))
					}
				</div>

				<div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
					<a
						href={repoUrl}
						class="text-teal-700 underline-offset-2 hover:underline dark:text-teal-400"
						target="_blank"
						rel="noopener noreferrer"
					>
						Source &amp; docs ↗
					</a>
					<a
						href={sponsorUrl}
						class="text-pink-700 underline-offset-2 hover:underline dark:text-pink-300"
						target="_blank"
						rel="noopener noreferrer"
					>
						♥ Sponsor ↗
					</a>
				</div>
			</div>
		</footer>
		<script is:inline>
			(function () {
				// ClientRouter swaps <body> on navigation, so a listener bound to
				// the old #theme-toggle node is lost — clicking it on any page
				// after the first did nothing. Delegate from `document` (it
				// survives view transitions) and guard with a window flag so a
				// re-run of this inline script can't stack duplicate handlers.
				if (window.__trackerThemeBound) return;
				window.__trackerThemeBound = true;
				document.addEventListener("click", function (e) {
					var t = e.target;
					var btn = t && t.closest ? t.closest("#theme-toggle") : null;
					if (!btn) return;
					var next = !document.documentElement.classList.contains("dark");
					document.documentElement.classList.toggle("dark", next);
					try {
						localStorage.setItem("tracker:theme", next ? "dark" : "light");
					} catch (err) {
						/* storage disabled — theme still applies for this session */
					}
				});
			})();
		</script>
		<script is:inline>
			// After load, not blocking — registering the worker is what makes
			// the PWA installable and gives "shows last-known data offline"
			// (see public/sw.js), but it shouldn't compete with the page's own
			// resources for priority on first paint.
			if ("serviceWorker" in navigator) {
				window.addEventListener("load", function () {
					navigator.serviceWorker.register("/tracker/sw.js", { scope: "/tracker/" });
				});
			}
		</script>
	</body>
</html>
