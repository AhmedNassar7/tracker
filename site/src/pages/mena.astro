---
import Layout from "../layouts/Layout.astro";
import OpportunityBrowser from "../components/OpportunityBrowser";
import RssFeedLinks from "../components/RssFeedLinks.astro";
---

<Layout
	title="MENA & Gulf tech jobs — tracker"
	description="Early-career software engineering jobs and internships across the Middle East, Gulf, and North Africa — Egypt, the UAE, Saudi Arabia and the wider region. Refreshed hourly, no signup, no fabricated data."
>
	<section class="mb-6">
		<h1 class="text-2xl font-semibold">MENA &amp; Gulf roles</h1>
		<p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
			Early-career software roles across the Middle East, Gulf, and North Africa — Egypt, the
			UAE, Saudi Arabia, and the wider region. The same hourly-refreshed list as the main
			board, pre-filtered to MENA. Pick a country below to narrow it further, or clear the
			region filter to go global.
		</p>
	</section>

	<OpportunityBrowser client:load presetFilters={{ regions: ["mena"] }} />

	<div class="mt-8">
		<RssFeedLinks />
	</div>
</Layout>
