---
import Layout from "../../layouts/Layout.astro";
import ResumeGapCheck from "../../components/ResumeGapCheck";
import WorkspaceNav from "../../components/WorkspaceNav.astro";

const POINTS = [
	{
		icon: "🎯",
		title: "Present · Missing · Extra",
		body: "The technologies a job names, split by what's already on your profile and what isn't.",
	},
	{
		icon: "🧩",
		title: "Same detector as the job list",
		body: "It reads skills with the exact rules the hourly pipeline uses to tag every posting — one shared vocabulary.",
	},
	{
		icon: "🔒",
		title: "Nothing leaves this browser",
		body: "A literal text diff, run locally. No upload, no account, no AI call.",
	},
];
---

<Layout
	title="Résumé keyword check — tracker"
	description="Paste a job description and see which of the tech skills it names are already on your profile and which are missing — a plain text diff, run entirely in your browser, no upload and no AI."
>
	<div class="mx-auto max-w-3xl">
		<WorkspaceNav />
		<h1 class="text-2xl font-semibold">Résumé keyword check</h1>
		<p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
			See how your profile lines up with one specific role before you apply.
		</p>

		<ul class="mt-5 grid gap-3 sm:grid-cols-3">
			{
				POINTS.map((p) => (
					<li class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
						<span aria-hidden="true" class="text-lg">
							{p.icon}
						</span>
						<p class="mt-1.5 text-sm font-medium text-slate-800 dark:text-slate-100">{p.title}</p>
						<p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{p.body}</p>
					</li>
				))
			}
		</ul>

		<div class="mt-8">
			<ResumeGapCheck client:load />
		</div>
	</div>
</Layout>
