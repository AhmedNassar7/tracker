---
import Layout from "../../layouts/Layout.astro";
import ResumeGapCheck from "../../components/ResumeGapCheck";
import WorkspaceNav from "../../components/WorkspaceNav.astro";
---

<Layout
	title="Résumé keyword check — tracker"
	description="Paste a job description and see which of the tech skills it names are already on your profile and which are missing — a plain text diff, run entirely in your browser, no upload and no AI."
>
	<div class="mx-auto max-w-3xl">
		<WorkspaceNav />
		<h1 class="text-2xl font-semibold">🎯 Résumé keyword check</h1>
		<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
			Paste a job description — the check runs in your browser. No upload, no AI.
		</p>

		<div class="mt-6">
			<ResumeGapCheck client:load />
		</div>
	</div>
</Layout>
