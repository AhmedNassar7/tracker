---
import Layout from "../layouts/Layout.astro";
import GlobalDashboard from "../components/GlobalDashboard";
import DashboardStory from "../components/DashboardStory";
---

<Layout
	title="Dashboard — tracker"
	description="A live overview of every job, hackathon, and event tracker currently publishes — region mix, level mix, top sources, and this week's hiring trends."
>
	<div class="mx-auto max-w-3xl">
		<h1 class="text-2xl font-semibold">🌍 Live overview</h1>
		<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
			Everything currently published · refreshed hourly
		</p>
		<div class="mt-6 space-y-8">
			<DashboardStory client:visible />
			<GlobalDashboard client:load />
		</div>
	</div>
</Layout>
