---
import Layout from "../layouts/Layout.astro";
import ApplicationsTracker from "../components/ApplicationsTracker";
import WorkspaceNav from "../components/WorkspaceNav.astro";

const POINTS = [
	{ icon: "🔖", title: "Bookmark from the list", body: "Hit Track on any role, or add an off-site application by hand." },
	{ icon: "📊", title: "Your own funnel", body: "Bookmarked → applied → OA → interview → offer, each step timestamped." },
	{ icon: "🔒", title: "This browser only", body: "Never sent anywhere. Export to CSV or JSON whenever you want." },
];
---

<Layout
	title="My Applications — tracker"
	description="Track your job applications through bookmarked, applied, OA, interview, and offer — stored locally on your device, exportable any time."
>
	<div class="mx-auto max-w-3xl">
		<WorkspaceNav />
		<h1 class="text-2xl font-semibold">My Applications</h1>
		<p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
			A private board for the roles you're actually chasing.
		</p>

		<ul class="mt-5 grid gap-3 sm:grid-cols-3">
			{
				POINTS.map((p) => (
					<li class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
						<span aria-hidden="true" class="text-lg">
							{p.icon}
						</span>
						<p class="mt-1.5 text-sm font-medium text-slate-800 dark:text-slate-100">{p.title}</p>
						<p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{p.body}</p>
					</li>
				))
			}
		</ul>

		<div class="mt-6">
			<ApplicationsTracker client:load />
		</div>
	</div>
</Layout>
