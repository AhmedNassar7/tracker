# dev-only fixtures: manual snapshots of ../data/*.json, used as a
# same-origin fallback so `astro dev` has real data before anything is
# pushed. Production always fetches cross-origin (src/lib/dataSource.ts) —
# these files must never be the site's real data source, so they aren't committed.
public/site-index.json
public/stats-history.json
